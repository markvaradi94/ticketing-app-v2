{
  "info": {
    "name": "Ticketing API",
    "description": "Requests for the course's ticketing-service, sent through api-gateway on port 8080. Start the whole system with `docker compose up --build`, or start ticketing-service with the dev profile (`./gradlew :ticketing-service:bootRun --args='--spring.profiles.active=dev'`) and the gateway (`./gradlew :api-gateway:bootRun`), then run the folders in order: Bookings and Reviews use the event that Events / Create an event makes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Events",
      "item": [
        {
          "name": "All events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns a list\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upcoming events in a city",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events?city=cluj",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "cluj"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Top events by booked seats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/top?n=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "top"
              ],
              "query": [
                {
                  "key": "n",
                  "value": "3"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"at most 3 events\", () => pm.expect(pm.response.json().length).to.be.at.most(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "One event (seeded by the dev profile)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/rock-cluj",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "rock-cluj"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown event: 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/nope",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "nope"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"body is a ProblemDetail\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create an event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Live\",\n  \"venueName\": \"Sala Polivalenta\",\n  \"city\": \"Cluj\",\n  \"startsAt\": \"2031-05-01T19:00:00\",\n  \"capacity\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Location points to the new event\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/events/\"));",
                  "pm.collectionVariables.set(\"eventId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid event: 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"venueName\": \"Arena\",\n  \"city\": \"Cluj\",\n  \"startsAt\": \"2020-01-01T19:00:00\",\n  \"capacity\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"body is a ProblemDetail\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Book seats",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerEmail\": \"ana@mail.ro\",\n  \"seats\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Uses the event created in Events / Create an event (capacity 3)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"bookingId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "One booking",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/bookings/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "bookings",
                "{{bookingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"same booking\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"bookingId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sold out: 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerEmail\": \"ion@mail.ro\",\n  \"seats\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"body is a ProblemDetail\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));",
                  "pm.test(\"says how many seats are left\", () => pm.expect(pm.response.json().availableSeats).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown event: 404",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/nope/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "nope",
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerEmail\": \"ana@mail.ro\",\n  \"seats\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"body is a ProblemDetail\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid booking: 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerEmail\": \"\",\n  \"seats\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"body is a ProblemDetail\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Add a review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "reviews"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"ana\",\n  \"rating\": 5,\n  \"comment\": \"Great show\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Uses the event created in Events / Create an event."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"review of the created event\", () => pm.expect(pm.response.json().eventId).to.eql(pm.collectionVariables.get(\"eventId\")));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"reviewId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Reviews of an event",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "reviews"
              ]
            },
            "description": "Uses the event created in Events / Create an event and the review added in Reviews / Add a review."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"lists the added review\", () => pm.expect(pm.response.json().map(r => r.id)).to.include(pm.collectionVariables.get(\"reviewId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid rating: 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "reviews"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"ana\",\n  \"rating\": 6,\n  \"comment\": \"Too good\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"body is a ProblemDetail\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown event: 404",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/nope/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "nope",
                "reviews"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"ana\",\n  \"rating\": 4,\n  \"comment\": \"Nice\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"body is a ProblemDetail\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rating summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/rating",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "rating"
              ]
            },
            "description": "Uses the event created in Events / Create an event; needs the review added in Reviews / Add a review."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"counts at least one review\", () => pm.expect(pm.response.json().reviewCount).to.be.at.least(1));",
                  "pm.test(\"has an average\", () => pm.expect(pm.response.json().averageRating).to.be.a(\"number\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "reviewId",
      "value": ""
    }
  ]
}
